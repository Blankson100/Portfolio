{
  "rewrites": [
    { "source": "/share-card.jpg", "destination": "/api/share-card" }
  ],
  "functions": {
    "api/share-card.js": { "includeFiles": "share-cards/**" }
  },
  "headers": [
    {
      "source": "/((?!share-card\\.jpg).*)\\.(png|jpg|jpeg|webp|gif|svg|mp4|pdf|woff2)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    }
  ]
}
